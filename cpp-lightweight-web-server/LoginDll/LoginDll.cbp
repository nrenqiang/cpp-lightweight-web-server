<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="LoginDll" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/LoginDll" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-DBUILD_DLL" />
					<Add option="-DSQLITE_THREADSAFE=0" />
					<Add option="-DSQLITE_OMIT_LOAD_EXTENSION" />
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="user32" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/LoginDll" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-DBUILD_DLL" />
					<Add option="-DSQLITE_THREADSAFE=0" />
					<Add option="-DSQLITE_OMIT_LOAD_EXTENSION" />
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="user32" />
				</Linker>
			</Target>
		</Build>
		<Unit filename="include/CDatabase.h" />
		<Unit filename="include/CUserLogin.h" />
		<Unit filename="include/IWebServer.h" />
		<Unit filename="include/sqlite3.h" />
		<Unit filename="src/CDatabase.cpp" />
		<Unit filename="src/CUserLogin.cpp" />
		<Unit filename="src/sqlite3.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
