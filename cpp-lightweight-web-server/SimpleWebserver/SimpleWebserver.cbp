<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="SimpleWebserver" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/SimpleWebserver" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-lws2_32" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/SimpleWebserver" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Unit filename="include/CBaseConverts.h" />
		<Unit filename="include/CLoadDll.h" />
		<Unit filename="include/CNet.h" />
		<Unit filename="include/CNetService.h" />
		<Unit filename="include/Config.h" />
		<Unit filename="include/IWebServer.h" />
		<Unit filename="src/CBaseConverts.cpp" />
		<Unit filename="src/CLoadDll.cpp" />
		<Unit filename="src/CNet.cpp" />
		<Unit filename="src/CNetService.cpp" />
		<Unit filename="src/Config.cpp" />
		<Unit filename="src/testNetMain.cpp" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
